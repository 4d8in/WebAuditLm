# Hosted Supabase project (Settings -> API in the dashboard) is the
# primary target now. SUPABASE_URL is the "Project URL" field there
# (https://<project-ref>.supabase.co) — NOT the dashboard page URL in your
# browser's address bar, that's a different thing and won't work here.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-project-service_role-key

# Local Docker stack is still available as an offline/no-account fallback —
# `supabase start` from the repo root, then swap the two values above for:
#   SUPABASE_URL=http://127.0.0.1:54321
#   SUPABASE_SERVICE_ROLE_KEY=<the SERVICE_ROLE_KEY `supabase start` prints>
PORT=8787

# Optional enrichment (all degrade gracefully if unset):
GOOGLE_API_KEY=
BROWSER_SERVICE_URL=
BROWSER_SERVICE_SECRET=

# Reporting agent (CLAUDE.md §3 / Step 4) — any OpenAI-compatible local
# chat-completions endpoint (Ollama: http://localhost:11434/v1, vLLM, etc).
#
# LLM_PROFILE picks which config below is active: "prod" (default, your
# real model) or "dev" (small/fast model for quick iteration). See
# backend/src/llm/profiles.ts for the resolution logic.
LLM_PROFILE=prod

REPORTING_LLM_ENDPOINT=
REPORTING_LLM_MODEL=
REPORTING_LLM_TIMEOUT_MS=180000

DEV_LLM_ENDPOINT=
DEV_LLM_MODEL=qwen2.5:3b
DEV_LLM_TIMEOUT_MS=30000
